# Copy to `.env` only if you need it; Spring Boot does not load `.env` by
# itself. Export the values (for example `set -a; . ./.env; set +a`) or pass
# them on the command line. The default demo needs none of them.
#
# Never commit a real credential. Real-provider operation is untested here.

# Real-provider credential.
OPENAI_API_KEY=

# Optional OpenAI-compatible gateway; otherwise the provider default applies.
SPRING_AI_OPENAI_BASE_URL=

# Optional model override.
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=

# Optional hosted OTLP/HTTP trace endpoint; defaults to the local viewer.
OTEL_EXPORTER_OTLP_ENDPOINT=
